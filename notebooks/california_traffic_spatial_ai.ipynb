# Enrich HERE Data with OSM Road Types
def enrich_with_osm_classifications(here_gdf, bbox_tuple):
    """
    Enrich HERE traffic segments with OSM road classifications.

    Parameters:
        here_gdf (GeoDataFrame): traffic segments from HERE API (EPSG:4326)
        bbox_tuple (tuple): (north, south, east, west)

    Returns:
        GeoDataFrame: HERE data with added OSM 'highway' and 'name' fields
    """
    north, south, east, west = bbox_tuple

    # Download drivable road network from OSM

    bbox = (west, south, east, north)
    G = ox.graph.graph_from_bbox(bbox, network_type="drive")
    osm_edges = ox.graph_to_gdfs(G, nodes=False)[["name", "highway", "geometry"]]

    # Reproject both to meters for spatial join
    here_proj = here_gdf.to_crs(epsg=3857)
    osm_proj = osm_edges.to_crs(epsg=3857)

    # Spatial join: find nearest OSM segment to each HERE segment
    joined = gpd.sjoin_nearest(here_proj, osm_proj, how="left", distance_col="match_distance")

    # Return enriched GeoDataFrame (projected back to EPSG:4326)
    enriched = joined.to_crs(epsg=4326)

    return enriched

bbox_tuple = (37.796, 37.785, -122.396, -122.410)
enriched_gdf = enrich_with_osm_classifications(traffic_gdf, bbox_tuple)

# Visualize HERE Data with folium map
def plot_enriched_segments_by_jamfactor(gdf, zoom_start=16):
    """
    Plot HERE+OSM segments with color by jamFactor and detailed popup.

    Parameters:
        gdf (GeoDataFrame): must contain 'jamFactor' and geometry
        zoom_start (int): folium zoom level
    """
    if gdf.empty or "jamFactor" not in gdf.columns:
        print("GeoDataFrame is empty or missing jamFactor.")
        return None

    center = gdf.unary_union.centroid
    m = folium.Map(location=[center.y, center.x], zoom_start=zoom_start)

    # Color scale for jamFactor (0 = free flow, 10 = heavy congestion)
    colormap = cm.LinearColormap(["green", "yellow", "orange", "red"], vmin=0, vmax=10)
    colormap.caption = "Jam Factor"

    for _, row in gdf.iterrows():
        jf = row.get("jamFactor")
        if jf is not None:
            color = colormap(jf)
            coords = [(lat, lon) for lon, lat in row.geometry.coords]

            popup_html = (
                f"<b>Road:</b> {row.get('roadName', 'Unknown')}<br>"
                f"<b>Current Speed:</b> {row.get('currentSpeed', 'n/a')}<br>"
                f"<b>Free Flow Speed:</b> {row.get('freeFlowSpeed', 'n/a')}<br>"
                f"<b>Jam Factor:</b> {jf}<br>"
                f"<b>OSM Type:</b> {row.get('highway', 'Unknown')}"
            )

            folium.PolyLine(
                locations=coords,
                color=color,
                weight=5,
                popup=folium.Popup(popup_html, max_width=300)
            ).add_to(m)

    colormap.add_to(m)
    return m

plot_enriched_segments_by_jamfactor(enriched_gdf)

## Clustering Approach

Two unsupervised clustering approaches were evaluated: DBSCAN and K-Means.

DBSCAN was initially explored because of its ability to identify spatially dense groups without specifying the number of clusters in advance. However, the resulting clusters were not well suited to separating roadway segments according to interpretable congestion states.

K-Means was therefore selected for the final analysis because it produced more interpretable groups based on traffic and roadway characteristics.
# Apply DBSCAN Clustering
def dbscan_with_highway(gdf, eps=200, min_samples=2):
    """
    Apply DBSCAN clustering using location, jamFactor, and road type.

    Parameters:
        gdf (GeoDataFrame): must contain 'jamFactor' and 'highway'
        eps (float): distance threshold (in meters)
        min_samples (int): minimum samples per cluster

    Returns:
        GeoDataFrame with added 'dbscan_cluster' label
    """
    df = gdf.dropna(subset=["jamFactor", "highway"]).copy()

    # Ordinal encoding of highway types
    highway_types = df["highway"].astype(str).unique()
    highway_map = {h: i for i, h in enumerate(sorted(highway_types))}
    df["highway_encoded"] = df["highway"].astype(str).map(highway_map)

    # Reproject to meters
    df_proj = df.to_crs(epsg=3857)
    df_proj["x"] = df_proj.geometry.centroid.x
    df_proj["y"] = df_proj.geometry.centroid.y

    # Prepare features
    df_proj["jamFactor_scaled"] = df_proj["jamFactor"] * 2.0
    df_proj["highway_encoded_scaled"] = df_proj["highway_encoded"] * 1.5

    X = df_proj[["x", "y", "jamFactor", "highway_encoded"]].values
    X_scaled = StandardScaler().fit_transform(X)

    # Apply DBSCAN
    db = DBSCAN(eps=eps, min_samples=min_samples).fit(X_scaled)
    df["dbscan_cluster"] = db.labels_

    return df

# Run DBSCAN using both jam factor and road type
clustered_enriched_gdf = dbscan_with_highway(enriched_gdf, eps=75, min_samples=3)

# Check how many segments per cluster
clustered_enriched_gdf["dbscan_cluster"].value_counts()

## Feature Engineering

Traffic and roadway characteristics were transformed into features suitable for clustering.

The primary congestion indicators were:

- **Jam Factor** — HERE traffic congestion measure
- **Speed Ratio** — current speed divided by free-flow speed
- **Road Class** — encoded OpenStreetMap highway classification
- **Spatial Location** — roadway segment coordinates

Features were standardized using `StandardScaler` before clustering so that differences in measurement scale would not dominate the model.

Traffic-related features were weighted more heavily than spatial characteristics to emphasize observed roadway conditions while retaining geographic context.
# Apply K-Means Clustering
def kmeans_with_speed_ratio(gdf, n_clusters=3):
    """
    Apply KMeans clustering using jamFactor, highway type, speed ratio, and spatial features.

    Parameters:
        gdf (GeoDataFrame): input GeoDataFrame with HERE API fields
        n_clusters (int): number of KMeans clusters

    Returns:
        GeoDataFrame: input with 'kmeans_cluster' column added
    """
    df = gdf.dropna(subset=["jamFactor", "highway", "currentSpeed", "freeFlowSpeed"]).copy()

    # Handle division and limit ratio
    df["speed_ratio"] = df["currentSpeed"] / df["freeFlowSpeed"]
    df["speed_ratio"] = df["speed_ratio"].clip(upper=1.0)  # cap at 1.0

    # Encode highway types
    highway_types = df["highway"].astype(str).unique()
    highway_map = {h: i for i, h in enumerate(sorted(highway_types))}
    df["highway_encoded"] = df["highway"].astype(str).map(highway_map)

    # Project to Web Mercator and extract coordinates
    df_proj = df.to_crs(epsg=3857)
    df_proj["x"] = df_proj.geometry.centroid.x
    df_proj["y"] = df_proj.geometry.centroid.y

    # Weight features
    df_proj["jamFactor_weighted"] = df_proj["jamFactor"] * 5.0
    df_proj["speed_ratio_weighted"] = df_proj["speed_ratio"] * 10.0
    df_proj["highway_encoded_weighted"] = df_proj["highway_encoded"] * 1.0

    # Assemble feature matrix
    X = df_proj[["x", "y", "jamFactor_weighted", "speed_ratio_weighted", "highway_encoded_weighted"]].values
    X_scaled = StandardScaler().fit_transform(X)

    # Apply KMeans
    kmeans = KMeans(n_clusters=n_clusters, random_state=42, n_init="auto")
    df["kmeans_cluster"] = kmeans.fit_predict(X_scaled)

    return df

kmeans_speed_ratio_gdf = kmeans_with_speed_ratio(enriched_gdf)

# Check how many per cluster
kmeans_speed_ratio_gdf["kmeans_cluster"].value_counts()

# Analyze K-Means clusters
# Group by cluster to inspect average jam factor and common highway types
cluster_summary = (
    kmeans_speed_ratio_gdf
    .groupby("kmeans_cluster")
    .agg(
        segment_count=("jamFactor", "count"),
        avg_jamFactor=("jamFactor", "mean"),
        avg_speed_ratio=("speed_ratio", "mean"),
        most_common_highway=("highway", lambda x: x.mode()[0] if not x.mode().empty else "Unknown")
    )
    .reset_index()
)

# Dynamic congestion labeling function
def label_kmeans_congestion_by_cluster(df, cluster_col="kmeans_cluster"):
    df = df.copy()

    # Summarize congestion behavior per cluster
    summary = (
        df.groupby(cluster_col)
        .agg(
            avg_jamFactor=("jamFactor", "mean"),
            avg_speed_ratio=("speed_ratio", "mean")
        )
        .reset_index()
    )

    # Score clusters: higher jamFactor, lower speed_ratio, more congested
    summary["congestion_score"] = summary["avg_jamFactor"] - summary["avg_speed_ratio"]
    sorted_clusters = summary.sort_values("congestion_score", ascending=False)[cluster_col].values

    label_map = {
        sorted_clusters[0]: "Moderate Flow",
        sorted_clusters[1]: "Free Flowing",
        sorted_clusters[2]: "Congested"
    }

    df["congestionLabel"] = df[cluster_col].map(label_map)
    return df

# Apply dynamic labeling to GeoDataFrame
labeled_kmeans_enriched_gdf = label_kmeans_congestion_by_cluster(kmeans_speed_ratio_gdf)

# Display updated summary
cluster_summary



# Visualize K-Means clusters with folium
import folium

def plot_enriched_kmeans_clusters(gdf, cluster_col="kmeans_cluster", zoom_start=16):
    """
    Plot enriched road segments color-coded by KMeans cluster with detailed popup.

    Parameters:
        gdf (GeoDataFrame): must include 'geometry' and clustering column
        cluster_col (str): column with cluster labels
        zoom_start (int): initial zoom level for the map
    """
    if gdf.empty or cluster_col not in gdf.columns:
        print("GeoDataFrame is empty or missing clustering column.")
        return None

    # Define interpreted cluster labels and colors
    label_map = {
        0: "Moderate Flow",
        1: "Free Flowing",
        2: "Congested"
    }

    color_map = {
        "Congested": "red",
        "Moderate Flow": "orange",
        "Free Flowing": "green"
    }

    # Center the map
    center = gdf.unary_union.centroid
    m = folium.Map(location=[center.y, center.x], zoom_start=zoom_start)

    # Add road segments with colored lines and popups
    for _, row in gdf.iterrows():
        cluster = row[cluster_col]
        label = label_map.get(cluster, f"Cluster {cluster}")
        color = color_map.get(label, "gray")
        coords = [(lat, lon) for lon, lat in row.geometry.coords]

        popup_html = (
            f"<b>Cluster:</b> {label}<br>"
            f"<b>Road:</b> {row.get('roadName', 'Unknown')}<br>"
            f"<b>Type:</b> {row.get('highway', 'Unknown')}<br>"
            f"<b>Jam Factor:</b> {row.get('jamFactor', 'n/a')}<br>"
            f"<b>Speed:</b> {row.get('currentSpeed', 'n/a')}<br>"
            f"<b>Free Flow Speed:</b> {row.get('freeFlowSpeed', 'n/a')}<br>"
            f"<b>Speed Ratio:</b> {row.get('speed_ratio', 'n/a')}"

        )

        folium.PolyLine(
            locations=coords,
            color=color,
            weight=5,
            popup=folium.Popup(popup_html, max_width=300)
        ).add_to(m)

    return m

plot_enriched_kmeans_clusters(kmeans_speed_ratio_gdf)

# Export tabular data and summary
def export_simplified_csv_and_summary(gdf, filename_prefix="simplified_congestion"):
    export_cols = ["roadName", "highway", "jamFactor", "speed_ratio", "congestionLabel", "kmeans_cluster"]
    df_out = gdf[export_cols].copy()
    df_out = df_out.fillna("n/a")

    # Save to CSV
    export_path = f"{filename_prefix}.csv"
    df_out.to_csv(export_path, index=False)

    # Summary stats
    summary = (
        df_out.groupby("congestionLabel")
        .agg(
            segment_count=("jamFactor", "count"),
            avg_jamFactor=("jamFactor", "mean"),
            avg_speed_ratio=("jamFactor", "mean"),
            most_common_highway=("highway", lambda x: x.mode()[0] if not x.mode().empty else "Unknown")
        )
        .reset_index()
    )

    return summary, df_out


simplified_summary, simplified_df = export_simplified_csv_and_summary(labeled_kmeans_enriched_gdf)
simplified_summary.head()


# Generate Road Name and Type Summary Tables
def generate_report_ready_road_summary(gdf):
    """
    Create a road-level summary with average jam factor, segment count,
    most common highway type, and congestion labels.
    """
    road_summary = (
        gdf.groupby("roadName")
        .agg(
            segment_count=("jamFactor", "count"),
            avg_jamFactor=("jamFactor", "mean"),
            avg_speed_ratio=("speed_ratio", "mean"),
            most_common_highway=("highway", lambda x: x.mode()[0] if not x.mode().empty else "Unknown"),
            congestion_labels=("congestionLabel", lambda x: ", ".join(sorted(x.dropna().unique())))
        )
        .reset_index()
        .sort_values(by="avg_jamFactor", ascending=False)
    )
    return road_summary

def export_road_summary_to_csv(df, filename="road_congestion_summary.csv"):
    """
    Save the road-level congestion summary to a CSV file.
    """
    df.to_csv(filename, index=False)
    print(f"Exported to {filename}")


road_summary = generate_report_ready_road_summary(labeled_kmeans_enriched_gdf)
export_road_summary_to_csv(road_summary)

def generate_highway_type_summary(gdf, filename="highway_type_summary.csv"):
    """
    Generate and export a summary of jam factor and congestion by highway type.
    Handles list-type highway values.
    """
    gdf = gdf.copy()

    # Ensure highway column is a consistent string
    gdf["highway"] = gdf["highway"].apply(
        lambda h: ", ".join(h) if isinstance(h, list) else str(h)
    )

    summary = (
        gdf.groupby("highway")
        .agg(
            segment_count=("jamFactor", "count"),
            avg_jamFactor=("jamFactor", "mean"),
            avg_speed_ratio=("speed_ratio", "mean"),
            most_common_congestion=("congestionLabel", lambda x: x.mode()[0] if not x.mode().empty else "Unknown")
        )
        .reset_index()
        .sort_values(by="avg_jamFactor", ascending=False)
    )

    # Export to CSV
    summary.to_csv(filename, index=False)
    print(f"Exported highway summary to {filename}")
    return summary

highway_summary = generate_highway_type_summary(labeled_kmeans_enriched_gdf)

