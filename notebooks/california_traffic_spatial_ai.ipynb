        "def export_simplified_csv_and_summary(gdf, filename_prefix=\"simplified_congestion\"):\n",
        "    export_cols = [\"roadName\", \"highway\", \"jamFactor\", \"speed_ratio\", \"congestionLabel\", \"kmeans_cluster\"]\n",
        "    df_out = gdf[export_cols].copy()\n",
        "    df_out = df_out.fillna(\"n/a\")\n",
        "\n",
        "    # Save to CSV\n",
        "    export_path = f\"{filename_prefix}.csv\"\n",
        "    df_out.to_csv(export_path, index=False)\n",
        "\n",
        "    # Summary stats\n",
        "    summary = (\n",
        "        df_out.groupby(\"congestionLabel\")\n",
        "        .agg(\n",
        "            segment_count=(\"jamFactor\", \"count\"),\n",
        "            avg_jamFactor=(\"jamFactor\", \"mean\"),\n",
        "            avg_speed_ratio=(\"jamFactor\", \"mean\"),\n",
        "            most_common_highway=(\"highway\", lambda x: x.mode()[0] if not x.mode().empty else \"Unknown\")\n",
        "        )\n",
        "        .reset_index()\n",
        "    )\n",
        "\n",
        "    return summary, df_out\n",
        "\n",
        "\n",
        "simplified_summary, simplified_df = export_simplified_csv_and_summary(labeled_kmeans_enriched_gdf)\n",
        "simplified_summary.head()\n",
        "\n"
      ]
    },
