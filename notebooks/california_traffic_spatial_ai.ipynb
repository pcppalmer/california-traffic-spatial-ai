      "source": [
        "import folium\n",
        "\n",
        "def plot_enriched_kmeans_clusters(gdf, cluster_col=\"kmeans_cluster\", zoom_start=16):\n",
        "    \"\"\"\n",
        "    Plot enriched road segments color-coded by KMeans cluster with detailed popup.\n",
        "\n",
        "    Parameters:\n",
        "        gdf (GeoDataFrame): must include 'geometry' and clustering column\n",
        "        cluster_col (str): column with cluster labels\n",
        "        zoom_start (int): initial zoom level for the map\n",
        "    \"\"\"\n",
        "    if gdf.empty or cluster_col not in gdf.columns:\n",
        "        print(\"GeoDataFrame is empty or missing clustering column.\")\n",
        "        return None\n",
        "\n",
        "    # Define interpreted cluster labels and colors\n",
        "    label_map = {\n",
        "        0: \"Moderate Flow\",\n",
        "        1: \"Free Flowing\",\n",
        "        2: \"Congested\"\n",
        "    }\n",
        "\n",
        "    color_map = {\n",
        "        \"Congested\": \"red\",\n",
        "        \"Moderate Flow\": \"orange\",\n",
        "        \"Free Flowing\": \"green\"\n",
        "    }\n",
        "\n",
        "    # Center the map\n",
        "    center = gdf.unary_union.centroid\n",
        "    m = folium.Map(location=[center.y, center.x], zoom_start=zoom_start)\n",
        "\n",
        "    # Add road segments with colored lines and popups\n",
        "    for _, row in gdf.iterrows():\n",
        "        cluster = row[cluster_col]\n",
        "        label = label_map.get(cluster, f\"Cluster {cluster}\")\n",
        "        color = color_map.get(label, \"gray\")\n",
        "        coords = [(lat, lon) for lon, lat in row.geometry.coords]\n",
        "\n",
        "        popup_html = (\n",
        "            f\"<b>Cluster:</b> {label}<br>\"\n",
        "            f\"<b>Road:</b> {row.get('roadName', 'Unknown')}<br>\"\n",
        "            f\"<b>Type:</b> {row.get('highway', 'Unknown')}<br>\"\n",
        "            f\"<b>Jam Factor:</b> {row.get('jamFactor', 'n/a')}<br>\"\n",
        "            f\"<b>Speed:</b> {row.get('currentSpeed', 'n/a')}<br>\"\n",
        "            f\"<b>Free Flow Speed:</b> {row.get('freeFlowSpeed', 'n/a')}<br>\"\n",
        "            f\"<b>Speed Ratio:</b> {row.get('speed_ratio', 'n/a')}\"\n",
        "\n",
        "        )\n",
        "\n",
        "        folium.PolyLine(\n",
        "            locations=coords,\n",
        "            color=color,\n",
        "            weight=5,\n",
        "            popup=folium.Popup(popup_html, max_width=300)\n",
        "        ).add_to(m)\n",
        "\n",
        "    return m\n",
        "\n",
        "plot_enriched_kmeans_clusters(kmeans_speed_ratio_gdf)\n"
      ]
    },
