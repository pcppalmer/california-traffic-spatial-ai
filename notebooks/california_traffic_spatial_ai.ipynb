        "def generate_report_ready_road_summary(gdf):\n",
        "    \"\"\"\n",
        "    Create a road-level summary with average jam factor, segment count,\n",
        "    most common highway type, and congestion labels.\n",
        "    \"\"\"\n",
        "    road_summary = (\n",
        "        gdf.groupby(\"roadName\")\n",
        "        .agg(\n",
        "            segment_count=(\"jamFactor\", \"count\"),\n",
        "            avg_jamFactor=(\"jamFactor\", \"mean\"),\n",
        "            avg_speed_ratio=(\"speed_ratio\", \"mean\"),\n",
        "            most_common_highway=(\"highway\", lambda x: x.mode()[0] if not x.mode().empty else \"Unknown\"),\n",
        "            congestion_labels=(\"congestionLabel\", lambda x: \", \".join(sorted(x.dropna().unique())))\n",
        "        )\n",
        "        .reset_index()\n",
        "        .sort_values(by=\"avg_jamFactor\", ascending=False)\n",
        "    )\n",
        "    return road_summary\n",
        "\n",
        "def export_road_summary_to_csv(df, filename=\"road_congestion_summary.csv\"):\n",
        "    \"\"\"\n",
        "    Save the road-level congestion summary to a CSV file.\n",
        "    \"\"\"\n",
        "    df.to_csv(filename, index=False)\n",
        "    print(f\"Exported to {filename}\")\n",
        "\n",
        "\n",
        "road_summary = generate_report_ready_road_summary(labeled_kmeans_enriched_gdf)\n",
        "export_road_summary_to_csv(road_summary)\n",
        "\n",
        "def generate_highway_type_summary(gdf, filename=\"highway_type_summary.csv\"):\n",
        "    \"\"\"\n",
        "    Generate and export a summary of jam factor and congestion by highway type.\n",
        "    Handles list-type highway values.\n",
        "    \"\"\"\n",
        "    gdf = gdf.copy()\n",
        "\n",
        "    # Ensure highway column is a consistent string\n",
        "    gdf[\"highway\"] = gdf[\"highway\"].apply(\n",
        "        lambda h: \", \".join(h) if isinstance(h, list) else str(h)\n",
        "    )\n",
        "\n",
        "    summary = (\n",
        "        gdf.groupby(\"highway\")\n",
        "        .agg(\n",
        "            segment_count=(\"jamFactor\", \"count\"),\n",
        "            avg_jamFactor=(\"jamFactor\", \"mean\"),\n",
        "            avg_speed_ratio=(\"speed_ratio\", \"mean\"),\n",
        "            most_common_congestion=(\"congestionLabel\", lambda x: x.mode()[0] if not x.mode().empty else \"Unknown\")\n",
        "        )\n",
        "        .reset_index()\n",
        "        .sort_values(by=\"avg_jamFactor\", ascending=False)\n",
        "    )\n",
        "\n",
        "    # Export to CSV\n",
        "    summary.to_csv(filename, index=False)\n",
        "    print(f\"Exported highway summary to {filename}\")\n",
        "    return summary\n",
        "\n",
        "highway_summary = generate_highway_type_summary(labeled_kmeans_enriched_gdf)\n",
        "\n"
      ]
    }
